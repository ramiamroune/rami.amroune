

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Electrical Energy Calculator</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 600px;
      margin: 40px auto;
      padding: 20px;
      background: #f3f6fa;
      color: #1f2937;
    }
    .card {
      background: white;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 4px 16px #0001;
    }
    label {
      display: block;
      margin-top: 16px;
      font-weight: bold;
    }
    input {
      width: 100%;
      box-sizing: border-box;
      padding: 11px;
      margin-top: 6px;
      border: 1px solid #ccd2da;
      border-radius: 7px;
    }
    button {
      margin-top: 20px;
      padding: 12px;
      width: 100%;
      border: 0;
      border-radius: 7px;
      background: #1769aa;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }
    #result {
      margin-top: 20px;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }
    .error {
      color: #b91c1c;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>⚡ Electrical Energy Calculator</h1>
    <p>Calculate electricity consumption and estimated cost.</p>

    <label for="power">Device power (watts)</label>
    <input id="power" type="number" min="0" step="any" value="1000">

    <label for="hours">Hours used per day</label>
    <input id="hours" type="number" min="0" max="24" step="any" value="5">

    <label for="days">Days used per month</label>
    <input id="days" type="number" min="0" max="31" step="1" value="30">

    <label for="rate">Electricity price per kWh</label>
    <input id="rate" type="number" min="0" step="any" value="5">

    <button type="button" onclick="calculate()">Calculate Consumption</button>

    <div id="result" aria-live="polite">
      Enter your values and calculate.
    </div>
  </div>

  <script>
    function calculate() {
      const power = document.getElementById("power").value;
      const hours = document.getElementById("hours").value;
      const days = document.getElementById("days").value;
      const rate = document.getElementById("rate").value;
      const result = document.getElementById("result");

      const values = [power, hours, days, rate];

      if (values.some(v => v.trim() === "")) {
        result.className = "error";
        result.textContent = "Please fill in all fields.";
        return;
      }

      const p = Number(power);
      const h = Number(hours);
      const d = Number(days);
      const r = Number(rate);

      if (![p, h, d, r].every(Number.isFinite) ||
          [p, h, d, r].some(v => v < 0)) {
        result.className = "error";
        result.textContent = "Please enter valid non-negative numbers.";
        return;
      }

      if (h > 24 || d > 31 || !Number.isInteger(d)) {
        result.className = "error";
        result.textContent =
          "Hours must be at most 24 and days must be a whole number from 0 to 31.";
        return;
      }

      const daily = p * h / 1000;
      const monthly = daily * d;
      const cost = monthly * r;

      result.className = "";
      result.replaceChildren();

      const heading = document.createElement("h2");
      heading.textContent = "Calculation Results";
      result.appendChild(heading);

      [
        "Daily consumption: " + daily.toFixed(2) + " kWh",
        "Monthly consumption: " + monthly.toFixed(2) + " kWh",
        "Estimated monthly cost: " + cost.toFixed(2) +
          " (in your entered currency)"
      ].forEach(text => {
        const p = document.createElement("p");
        p.textContent = text;
        result.appendChild(p);
      });
    }
  </script>
</body>
</html>
